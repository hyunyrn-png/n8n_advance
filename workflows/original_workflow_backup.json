    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst filtered = [];\nconst includeKeywords = ['펀드','투자신탁','ETF','자산운용','공모','ISA','IRP','연금저축','퇴직연금','비과세','세제','조세','과세','면세','감면','금융투자','증권','자본시장','금융소비자','금융위','금감원'];\nconst excludeKeywords = ['인사','승진','임명','취임','전보','이임','채용','모집','공모전','시험','광고'];\nfor (const item of items) {\n  const title = item.json.title || '';\n  const hasExclude = excludeKeywords.some(kw => title.includes(kw));\n  if (hasExclude) continue;\n  const hasInclude = includeKeywords.some(kw => title.includes(kw));\n  if (hasInclude) {\n    filtered.push({ json: { title, link: item.json.link || item.json.url || '', pubDate: item.json.pubDate || item.json.isoDate || '', source: item.json.source || '기타' } });\n  }\n}\nconst seen = new Set();\nconst unique = filtered.filter(item => { const key = item.json.title.toLowerCase().replace(/\\s/g, ''); if (seen.has(key)) return false; seen.add(key); return true; });\nreturn unique.slice(0, 15);"
      },
